// KAMA Spa (kamaspa.id) — schema diturunkan dari Lampiran I kontrak 01/PKS/XI/KAMA/2026.
// Bagian B = struktur halaman publik, Bagian D = 14 modul admin yang harus bisa dikelola tanpa koding.
// Harga disimpan sebagai Int rupiah penuh (tanpa desimal) sesuai DoD modul Harga.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
  EDITOR
}

enum PublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

/**
 * ---------- Modul 14: Pengguna Admin ----------
 */

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)

  // Lampiran I poin 8: pembatasan percobaan login admin.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  // Disalin ke JWT; dinaikkan saat password/role/status berubah sehingga
  // semua sesi lama otomatis tidak berlaku.
  sessionVersion     Int       @default(0)
  // Diset saat akun dibuat/di-reset oleh ADMIN: user wajib mengganti sendiri.
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?

  mediaUploads MediaAsset[]
  backupRuns   BackupRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * ---------- Modul 1 & 2: Treatments, Packages, Harga ----------
 */

enum CategoryKind {
  TREATMENT // treatment utama
  ADDON // tambahan yang dipesan bersama treatment utama
}

// Letak add-on di halaman /menu.
enum AddonSection {
  BODY // grid "Body" (scrub, mask)
  FACE // section Face Ritual
  HEAD_SCALP // section Head & Scalp
  BATH // section Bath Ritual
}

model TreatmentCategory {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String?
  imageUrl    String?
  kind        CategoryKind @default(TREATMENT)
  isPublished Boolean      @default(true)
  sortOrder   Int          @default(0)

  seoTitle       String?
  seoDescription String?

  treatments Treatment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Treatment {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  // Kalimat singkat di kartu /menu.
  tagline      String?
  description  String?
  // Catatan kecil di halaman detail, mis. "tanpa minyak".
  note         String?
  imageUrl     String?
  // Hanya untuk treatment di kategori ADDON.
  addonSection AddonSection?

  isNew        Boolean @default(false)
  isBestSeller Boolean @default(false)
  isPublished  Boolean @default(true)
  sortOrder    Int     @default(0)

  seoTitle       String?
  seoDescription String?

  // Pesan WhatsApp khusus treatment ini; kosong = pakai template default.
  whatsappMessage String?

  categoryId String
  category   TreatmentCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  options      TreatmentOption[]
  packageItems PackageItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, sortOrder])
}

// Varian durasi + harga untuk satu treatment (mis. 60 min / 90 min).
model TreatmentOption {
  id          String @id @default(cuid())
  label       String
  durationMin Int
  priceIdr    Int
  sortOrder   Int    @default(0)

  treatmentId String
  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([treatmentId, sortOrder])
}

model Package {
  id            String  @id @default(cuid())
  slug          String  @unique
  name          String
  subtitle      String?
  quote         String?
  description   String?
  imageUrl      String?
  durationMin   Int?
  // Teks durasi yang ditampilkan, mis. "2 hours 30 minute"; kosong = dari durationMin.
  durationLabel String?
  priceIdr      Int
  isNew         Boolean @default(false)
  isBestSeller  Boolean @default(false)
  isPublished   Boolean @default(true)
  sortOrder     Int     @default(0)

  seoTitle        String?
  seoDescription  String?
  whatsappMessage String?

  items PackageItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PackageItem {
  id        String @id @default(cuid())
  sortOrder Int    @default(0)

  // Item bisa merujuk treatment yang ada, atau sekadar teks bebas.
  label   String?
  minutes Int?

  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  treatmentId String?
  treatment   Treatment? @relation(fields: [treatmentId], references: [id], onDelete: SetNull)

  @@index([packageId, sortOrder])
}

/**
 * ---------- Modul 3: Foto & Gallery ----------
 */

model GalleryAlbum {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  coverUrl    String?
  isPublished Boolean @default(true)
  sortOrder   Int     @default(0)

  photos GalleryPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryPhoto {
  id        String  @id @default(cuid())
  imageUrl  String
  caption   String?
  altText   String?
  sortOrder Int     @default(0)

  albumId String
  album   GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([albumId, sortOrder])
}

/**
 * ---------- Modul 4: Promos & Gift Card ----------
 */

model Promo {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String?
  bannerUrl   String?
  terms       String?

  // Promo otomatis hilang dari publik setelah endDate lewat (DoD modul Promos).
  startDate DateTime?
  endDate   DateTime?

  isPublished Boolean @default(true)
  sortOrder   Int     @default(0)

  seoTitle        String?
  seoDescription  String?
  whatsappMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([endDate])
}

// Singleton: konten halaman Gift Card.
model GiftCardInfo {
  id              String   @id @default("singleton")
  title           String
  // Kalimat di bawah judul halaman /gift-card. Kosong = teks bawaan.
  subtitle        String?
  bodyHtml        String
  imageUrl        String?
  // Syarat & ketentuan gift card (HTML tersanitasi).
  termsHtml       String?
  // Teks awal chat WhatsApp tombol "Pesan via WhatsApp". Kosong = bawaan.
  whatsappMessage String?
  updatedAt       DateTime @updatedAt
}

/**
 * ---------- Modul 5: Membership ----------
 */

// Singleton: informasi program membership (halaman /membership dan banner
// membership di homepage). Tier/paket ada di MembershipTier.
model MembershipProgram {
  id             String  @id @default("singleton")
  eyebrow        String
  title          String
  intro          String
  // Kalimat harga, contoh "Just Rp 1.5jt a month." — dipakai di homepage
  // dan di bagian Main Benefits halaman /membership.
  priceHeadline  String
  // Deskripsi singkat di banner membership homepage, beserta tombolnya.
  bannerBody     String
  bannerCtaLabel String?
  bannerCtaHref  String?
  // [{ title, body }] — benefit utama program.
  benefits       Json
  servicesIntro  String
  // [{ name, description }] — essential services yang bisa dipakai kredit.
  services       Json
  // Syarat & ketentuan program (HTML tersanitasi).
  termsHtml      String?

  updatedAt DateTime @updatedAt
}

model MembershipTier {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  priceLabel  String
  // Harga angka (rupiah penuh) yang diubah dari modul Harga; priceLabel lalu
  // ditulis ulang dari angka ini. Null = harga non-angka, contoh "Custom".
  priceIdr    Int?
  billingNote String?
  summary     String?

  // Daftar benefit sebagai list teks yang bisa diedit admin.
  benefits String[]
  terms    String?

  isPublished Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * ---------- Modul 6: Journal ----------
 */

/**
 * Kategori artikel Journal. Dulu kolom teks bebas di JournalPost: tidak bisa
 * diurutkan admin dan salah ketik membuat kategori baru. Sekarang tabel
 * sendiri dengan sortOrder, sama seperti TreatmentCategory dan GalleryAlbum.
 */
model JournalCategory {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  isPublished Boolean @default(true)
  sortOrder   Int     @default(0)

  posts JournalPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model JournalPost {
  id       String   @id @default(cuid())
  slug     String   @unique
  title    String
  excerpt  String?
  bodyHtml String
  coverUrl String?
  tags     String[]

  // Kategori dihapus → artikel kehilangan kategorinya, tidak ikut terhapus.
  categoryId String?
  category   JournalCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  status      PublishStatus @default(DRAFT)
  // Dipakai untuk penjadwalan publikasi: tampil publik bila <= now().
  publishedAt DateTime?

  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
}

/**
 * ---------- Modul 7: Events ----------
 */

model EventItem {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String?
  coverUrl    String?
  location    String?

  startDate DateTime?
  endDate   DateTime?

  // Memisahkan "upcoming events" dari "past collaborations" (Lampiran I Bagian B).
  isCollaboration Boolean @default(false)
  // Mitra kolaborasi (past collaborations): nama, logo, dan tautan.
  partnerName     String?
  partnerLogoUrl  String?
  partnerUrl      String?
  isPublished     Boolean @default(true)
  sortOrder       Int     @default(0)

  seoTitle       String?
  seoDescription String?

  photos EventPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate])
}

model EventPhoto {
  id        String  @id @default(cuid())
  imageUrl  String
  caption   String?
  sortOrder Int     @default(0)

  eventId String
  event   EventItem @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, sortOrder])
}

/**
 * ---------- Modul 8: KAMA Retail ----------
 */

model RetailProduct {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  imageUrl    String?
  priceIdr    Int?

  isHighlight     Boolean @default(false)
  // Produk hasil kolaborasi, tampil di bagian terpisah dari highlight.
  isCollaboration Boolean @default(false)
  isPublished     Boolean @default(true)
  sortOrder       Int     @default(0)

  // Tanpa keranjang/pembayaran online — pemesanan lewat WhatsApp (Lampiran I).
  whatsappMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * ---------- Modul 9: Corporate Wellness ----------
 */

// Singleton: konten program + PIC halaman Corporate Wellness.
model CorporateContent {
  id           String   @id @default("singleton")
  heroTitle    String
  intro        String?
  inOfficeHtml String?
  inSpaHtml    String?
  stepsHtml    String?
  picName      String?
  picEmail     String?
  picPhone     String?
  // Daftar benefit ("Higher employee engagement", dst.).
  benefits     String[] @default([])
  // [{ title, items: string[] }] — blok "solutions" halaman corporate.
  solutions    Json?
  // Daftar "Ideal For" bagian In-Spa.
  inSpaItems   String[] @default([])
  updatedAt    DateTime @updatedAt
}

// Paket program corporate (Essential, Signature, Executive, ...).
model CorporateProgram {
  id          String   @id @default(cuid())
  name        String
  description String?
  features    String[] @default([])
  imageUrl    String?
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Langkah "collaboration process".
model CorporateStep {
  id        String  @id @default(cuid())
  title     String
  body      String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Klien corporate: logo + foto dokumentasi kegiatan.
model CorporateClient {
  id          String   @id @default(cuid())
  name        String
  description String?
  // Tahun kerja sama, tampil di bagian past collaborations.
  year        Int?
  logoUrl     String?
  websiteUrl  String?
  // Foto dokumentasi (URL Media Library), urut sesuai tampil.
  photoUrls   String[] @default([])
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Data pribadi (UU PDP, Pasal 11 ayat 7) — hanya dibaca lewat admin action ber-role.
model CorporateInquiry {
  id          String        @id @default(cuid())
  name        String
  company     String?
  email       String
  phone       String?
  message     String
  status      InquiryStatus @default(NEW)
  notes       String?
  // Notifikasi email ke PIHAK PERTAMA: waktu terkirim, atau pesan galat.
  emailSentAt DateTime?
  emailError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

/**
 * ---------- Modul 10: Homepage & Our Story ----------
 */

// Tiap section homepage bisa di-toggle & diurutkan dari dashboard.
model HomepageSection {
  id             String  @id @default(cuid())
  key            String  @unique
  eyebrow        String?
  title          String
  subtitle       String?
  bodyHtml       String?
  imageUrl       String?
  // Banner/hero: gambar khusus layar kecil, teks alt, dan tombol ajakan.
  mobileImageUrl String?
  imageAlt       String?
  ctaLabel       String?
  ctaHref        String?
  isEnabled      Boolean @default(true)
  sortOrder      Int     @default(0)

  updatedAt DateTime @updatedAt
}

enum HeroSlideMediaType {
  IMAGE
  VIDEO
}

// Media slider hero. Teks/CTA tetap dari HomepageSection berkey "hero".
// VIDEO wajib punya poster (imageUrl) agar tetap tampil saat autoplay diblokir.
model HeroSlide {
  id             String             @id @default(cuid())
  mediaType      HeroSlideMediaType @default(IMAGE)
  imageUrl       String?
  mobileImageUrl String?
  videoUrl       String?
  imageAlt       String?
  isPublished    Boolean            @default(true)
  sortOrder      Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([isPublished, sortOrder])
}

// Kartu highlight homepage (section "What's New" / konten sorotan).
model HomepageHighlight {
  id          String    @id @default(cuid())
  eyebrow     String?
  title       String
  body        String?
  imageUrl    String?
  imageAlt    String?
  href        String?
  ctaLabel    String?
  // Opsional: tampil hanya dalam periode ini.
  startDate   DateTime?
  endDate     DateTime?
  isPublished Boolean   @default(true)
  sortOrder   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Singleton: halaman Our Story.
model OurStoryContent {
  id             String   @id @default("singleton")
  heroTitle      String
  heroImageUrl   String?
  philosophyHtml String?
  valuesHtml     String?
  seoTitle       String?
  seoDescription String?
  updatedAt      DateTime @updatedAt
}

/**
 * ---------- Modul 11: Menu Navigasi ----------
 */

enum MenuLinkType {
  PAGE // halaman dari modul Halaman & URL; URL mengikuti slug-nya
  INTERNAL_URL // path di situs ini, mis. /treatments
  EXTERNAL_URL // https://…, mailto:, tel:
  ANCHOR // #bagian atau /halaman#bagian
  NO_LINK // judul/kelompok tanpa tautan (mis. judul kolom mega menu)
}

enum MenuLocation {
  HEADER
  FOOTER
  MOBILE
}

// Pohon menu maks. 3 level. Lokasi hanya dibaca dari item level 1; anak
// mengikuti induknya.
model MenuItem {
  id        String         @id @default(cuid())
  label     String
  linkType  MenuLinkType   @default(INTERNAL_URL)
  // Dipakai INTERNAL_URL, EXTERNAL_URL, ANCHOR. Kosong untuk PAGE dan NO_LINK.
  url       String?
  sortOrder Int            @default(0)
  isVisible Boolean        @default(true)
  // true = target="_blank"
  openInNew Boolean        @default(false)
  locations MenuLocation[] @default([HEADER, MOBILE])

  pageId String?
  page   StaticPage? @relation(fields: [pageId], references: [id], onDelete: SetNull)

  // Khusus level 1 di header: kunci panel (ID DOM) dan teks tautan
  // "lihat semua" di bawah mega menu.
  panelKey       String?
  panelLinkLabel String?

  // Kartu highlight di mega menu dan lebar panelnya (piksel); sebelumnya
  // preset statis per panelKey, kini bisa diatur admin.
  highlightImageUrl String?
  highlightLabel    String?
  highlightHref     String?
  panelWidth        Int?

  parentId String?
  parent   MenuItem?  @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuTree")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, sortOrder])
}

/**
 * ---------- Modul 12: Informasi Kontak & Umum ----------
 */

// Cabang: kartu di halaman kontak, penanda peta, dan pilihan di form
// reservasi/newsletter. `tag` dipakai sebagai label kecil ("Flagship",
// "Coming Soon"); koordinat dipakai penanda Leaflet.
model Branch {
  id      String  @id @default(cuid())
  slug    String  @unique
  name    String
  // Nama area, tampil di samping nama cabang: "South Jakarta | Kramat Pela".
  area    String
  tag     String?
  address String?

  // Jam operasional disimpan per baris, sama seperti SiteSettings.
  openingHours String[] @default([])

  whatsappNumber String?
  phone          String?
  email          String?

  // Embed peta di kartu cabang, dan tautan "get directions".
  mapsEmbedUrl String?
  mapsUrl      String?

  latitude  Float?
  longitude Float?

  isPublished Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Singleton: dipakai footer, halaman kontak, dan embed maps.
model SiteSettings {
  id           String  @id @default("singleton")
  address      String?
  mapsEmbedUrl String?

  // Jam operasional disimpan sebagai teks per baris agar admin bebas mengaturnya.
  openingHours String[]

  whatsappNumber String?
  email          String?
  phone          String?

  instagramUrl String?
  tiktokUrl    String?
  facebookUrl  String?
  freshaUrl    String?

  // Username Instagram (tanpa @) untuk feed/tautan profil.
  instagramUsername String?
  // Google Analytics 4 Measurement ID, contoh "G-XXXXXXXXXX". Kosong = GA4 mati.
  ga4MeasurementId  String?
  // Isi meta google-site-verification (Google Search Console).
  gscVerification   String?
  // Favicon & gambar Open Graph bawaan (dipakai bila halaman tidak punya).
  faviconUrl        String?
  defaultOgImageUrl String?

  // Catatan harga di halaman menu, contoh "Harga belum termasuk pajak".
  priceDisclaimer            String?
  // Tagline di footer.
  footerTagline              String?
  // CTA membership di footer.
  footerMembershipTitle      String?
  footerMembershipLearnLabel String?
  footerMembershipJoinLabel  String?
  // Blok partnership di footer.
  partnershipIntro           String?
  partnershipEmail           String?
  // Tombol Book Now di header: teks dan tujuannya.
  bookNowLabel               String?
  bookNowHref                String?

  // Halaman scan menu (URL Media Library), urut sesuai tampil, dan berkas PDF-nya.
  menuScanUrls String[] @default([])
  menuPdfUrl   String?

  updatedAt DateTime @updatedAt
}

// Template pesan WhatsApp per konteks (default, treatment, promo, retail, dll).
model WhatsAppTemplate {
  id      String @id @default(cuid())
  key     String @unique
  label   String
  // Boleh memuat placeholder, mis. {{name}}.
  message String

  updatedAt DateTime @updatedAt
}

/**
 * ---------- Modul 13: SEO ----------
 */

model PageSeo {
  id          String  @id @default(cuid())
  path        String  @unique
  title       String?
  description String?
  ogImageUrl  String?

  updatedAt DateTime @updatedAt
}

// Teks halaman publik yang dapat diedit admin. `group` menentukan
// pengelompokan di dashboard (mis. "home", "contact", "global").
model ContentBlock {
  key       String   @id
  group     String
  value     String
  updatedAt DateTime @updatedAt

  @@index([group])
}

/**
 * ---------- Modul 14: Halaman & URL ----------
 */

enum PageStatus {
  DRAFT
  PUBLISHED
}

// Tata letak halaman publik; menentukan komponen render di src/app/[slug].
enum PageTemplate {
  STANDARD // judul + isi teks berformat
  LEGAL // tata letak dokumen panjang seperti Kebijakan Privasi
}

// Halaman bebas yang dibuat admin, tampil di /<slug>.
model StaticPage {
  id       String       @id @default(cuid())
  slug     String       @unique
  title    String
  template PageTemplate @default(STANDARD)
  bodyHtml String       @default("")

  seoTitle       String?
  seoDescription String?

  status      PageStatus @default(DRAFT)
  publishedAt DateTime?

  menuItems MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Pengalihan URL lama → URL baru, diterapkan di src/proxy.ts. Dibuat otomatis
// saat slug berubah, atau manual dari dashboard. Rantai selalu diratakan
// (A→C, bukan A→B→C) oleh planSlugRedirect di src/lib/domain/page-url.ts.
model Redirect {
  id         String  @id @default(cuid())
  fromPath   String  @unique
  toPath     String
  statusCode Int     @default(301)
  // "auto" = dibuat sistem saat slug berubah; "manual" = diisi admin.
  source     String  @default("manual")
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * ---------- Media Library ----------
 */

// Satu baris per berkas di Supabase Storage. Konten lain tetap menyimpan URL
// (bukan relasi), jadi pemakaian dihitung dengan mencocokkan URL.
model MediaAsset {
  id         String  @id @default(cuid())
  url        String  @unique
  storageKey String  @unique
  fileName   String
  title      String?
  altText    String?
  mimeType   String
  sizeBytes  Int
  width      Int?
  height     Int?
  folder     String  @default("misc")
  sortOrder  Int     @default(0)

  uploadedById String?
  uploadedBy   AdminUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folder, sortOrder])
}

/**
 * ---------- Modul 19: Backup & Status ----------
 */

enum BackupKind {
  MANUAL // diunduh admin dari dashboard
  AUTO // dijalankan terjadwal (mis. GitHub Actions mingguan)
  HANDOVER // salinan lengkap saat serah terima
}

enum BackupStatus {
  SUCCESS
  FAILED
}

// Catatan setiap backup — isi backup TIDAK disimpan di sini.
model BackupRun {
  id            String       @id @default(cuid())
  kind          BackupKind
  status        BackupStatus
  // Format/isi, contoh "pg_dump .sql.gz" atau "JSON (tanpa data inquiry)".
  format        String
  sizeBytes     Int?
  // Lokasi penyimpanan (mis. "GitHub Actions artifact #123"), tanpa kredensial.
  location      String?
  note          String?
  // Admin yang memicu (MANUAL/HANDOVER); null untuk AUTO.
  triggeredById String?
  triggeredBy   AdminUser?   @relation(fields: [triggeredById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([createdAt])
}

/**
 * ---------- Konten section homepage ----------
 */

// Angka di section Brand Intro ("12 years of care", ...).
model HomepageStat {
  id          String  @id @default(cuid())
  value       String
  label       String
  isPublished Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Ulasan di section Reviews.
model HomepageReview {
  id          String  @id @default(cuid())
  quote       String
  name        String
  location    String?
  role        String?
  isPublished Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Foto feed Instagram yang dipilih admin (tanpa API berbayar / token).
model InstagramPost {
  id          String  @id @default(cuid())
  imageUrl    String
  imageAlt    String?
  // Tautan ke postingan; kosong = tautan profil.
  href        String?
  isPublished Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * ---------- Analitik pengunjung ----------
 */

// Satu baris = satu tampilan halaman publik. Sengaja tidak menyimpan IP atau
// User-Agent: `visitorId` adalah ID acak dari cookie httpOnly yang dipasang
// proxy, dipakai hanya untuk menghitung pengunjung unik. Halaman admin, API,
// aset, bot, dan prefetch tidak dicatat (lihat src/lib/domain/page-view.ts).
model PageView {
  id        BigInt   @id @default(autoincrement())
  path      String
  visitorId String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([visitorId, createdAt])
}
