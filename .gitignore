# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# dump database dari scripts/backup-db.sh — berisi data asli, jangan di-commit
/backups

# env files (can opt-in for committing if needed)
.env*
# Kecuali contoh konfigurasi — tanpa satu pun nilai asli di dalamnya.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

references/*.pdf
.playwright-mcp
# local agent tooling
/.claude/
opencode.json
.opencode
references/
AGENTS.md
# `docs/` TIDAK diabaikan: isinya dokumen serah terima (Pasal 8 ayat 7i & 11)
# yang wajib ikut diserahkan bersama source code.
.opencode-mem
.agents
.vscode
.cursor
.devin
opencode-mem.jsonc
.claude
docs/*md
docs/user-guide/*md
graphify-out