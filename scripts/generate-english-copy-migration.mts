/**
 * Generate migrasi English visitor copy dari pasangan old↔new (tanpa tulis tangan).
 *
 *   node scripts/generate-english-copy-migration.mts old.json [new.json] [missing.json]
 *
 * old.json = nilai live (inventaris DB, atau ekstraksi git HEAD sebagai baseline).
 * new.json = nilai kanonik current (default: collectAll()).
 * missing.json = baris {table, match} yang belum ada di DB live → ContentBlock
 *   di-INSERT English (reader tanpa fallback statis), bukan UPDATE no-op.
 * Output: prisma/migrations/20261127090000_english_visitor_copy/migration.sql
 *         scripts/english-copy/rollback.sql + laporan coverage (stdout).
 */
import "./load-env.mts";
import { readFileSync, writeFileSync, mkdirSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

import { collectAll, type CopyRow } from "./english-copy/collect.mts";
import { INLINE_LITERALS } from "./english-copy/inline-literals.mts";
import { rowKey, type Emitter } from "./english-copy/generate.helpers.mts";
import { emitGeneric, emitMenu, emitTier, emitFormsInsert, emitContentBlockInsert } from "./english-copy/generate.emit.mts";
import { q, sqlString } from "./english-copy/sql.mts";

const here = dirname(fileURLToPath(import.meta.url));

function checkInvariants(rows: CopyRow[]): void {
  const find = (t: string, k: string, v: string) => rows.find((r) => r.table === t && r.match[k] === v);
  const intro = find("MembershipProgram", "id", "singleton")?.fields.intro;
  const tagline = find("SiteSettings", "id", "singleton")?.fields.footerTagline;
  const hero = rows.find((r) => r.table === "ContentBlock" && r.match.key === "promos.membership.hero_description")?.fields.value;
  if (intro !== tagline || intro !== hero) throw new Error("Invariant intro canonical gagal (intro/footerTagline/hero_description)");
  const prices = JSON.stringify(rows.filter((r) => r.table === "MembershipTier" || r.table === "MembershipProgram").map((r) => r.fields));
  if (/\d[.,]\d\s*(jt|rb)\b|million/i.test(prices)) throw new Error("Invariant notasi IDR gagal (jt/rb/million ditemukan)");
}

const oldRows = JSON.parse(readFileSync(process.argv[2], "utf8")) as CopyRow[];
const newRows = process.argv[3]
  ? (JSON.parse(readFileSync(process.argv[3], "utf8")) as CopyRow[])
  : collectAll();
checkInvariants(newRows);

const missingRows = process.argv[4]
  ? (JSON.parse(readFileSync(process.argv[4], "utf8")) as { table: string; match: Record<string, string | number> }[])
  : [];
const missingKeys = new Set(missingRows.map((r) => rowKey({ ...r, fields: {} })));

const oldMap = new Map(oldRows.map((r) => [rowKey(r), r]));
const e: Emitter = { fwd: [], rev: [], changed: 0, coverage: new Map() };

for (const n of newRows) {
  const o = oldMap.get(rowKey(n));
  if (n.table === "ContentBlock" && String(n.match.key).startsWith("forms.reservation.")) emitFormsInsert(e, n);
  else if (n.table === "ContentBlock" && missingKeys.has(rowKey(n))) emitContentBlockInsert(e, n);
  if (n.table === "MenuItem") emitMenu(e, o, n);
  else if (n.table === "MembershipTier") emitTier(e, o!, n);
  else emitGeneric(e, o, n);
}

for (const lit of INLINE_LITERALS) {
  const where = Object.entries(lit.match).map(([k, v]) => `${q(k)} = ${sqlString(v)}`).join(" AND ");
  const guardOld = lit.old === null ? `${q(lit.field)} IS NULL` : `${q(lit.field)} = ${sqlString(lit.old)}`;
  const setOld = lit.old === null ? "NULL" : sqlString(lit.old);
  e.fwd.push(`UPDATE ${q(lit.table)} SET ${q(lit.field)} = ${sqlString(lit.new)} WHERE ${where} AND ${guardOld};`);
  e.rev.push(`UPDATE ${q(lit.table)} SET ${q(lit.field)} = ${setOld} WHERE ${where} AND ${q(lit.field)} = ${sqlString(lit.new)};`);
  e.changed++;
  e.coverage.set(lit.table, (e.coverage.get(lit.table) ?? 0) + 1);
}

const wrap = (stmts: string[], title: string) => [
  `-- ${title}`,
  "-- Generated by scripts/generate-english-copy-migration.mts — JANGAN edit tangan.",
  "DO $$ BEGIN",
  `  IF NOT EXISTS (SELECT 1 FROM "SiteSettings" WHERE "id" = 'singleton') THEN RETURN; END IF;`,
  ...stmts.map((s) => "  " + s),
  "END $$;",
  "",
].join("\n");

const migDir = join(here, "..", "prisma", "migrations", "20261127090000_english_visitor_copy");
mkdirSync(migDir, { recursive: true });
writeFileSync(join(migDir, "migration.sql"), wrap(e.fwd, "20261127090000_english_visitor_copy — copy visitor Indonesia → English"));
writeFileSync(join(here, "english-copy", "rollback.sql"), wrap([...e.rev].reverse(), "rollback English → Indonesia (jalankan manual bila perlu)"));

console.log(`✔ ${e.changed} perubahan field, ${e.fwd.length} statement forward → ${migDir}/migration.sql`);
console.log("=== coverage (field berubah per tabel) ===");
for (const [t, c] of [...e.coverage].sort((a, b) => b[1] - a[1])) console.log(`  ${t.padEnd(22)} ${c}`);
console.log("=== permukaan butuh inventaris DB (belum tercakup git) ===");
console.log("  HomepageHighlight/Stat, GalleryAlbum/Photo, ContentImage, EventItem/Photo,");
console.log("  Promo, RetailProduct, CorporateClient, OurStoryContent, HeroSlide.imageAlt,");
console.log("  JournalPost.bodyHtml (admin), CorporateContent.inOffice/inSpa/stepsHtml,");
console.log("  GiftCardInfo.termsHtml, HomepageSection.bodyHtml, Treatment/Package seo+whatsapp,");
console.log("  TreatmentCategory.description, edit admin Branch/SiteSettings kontak.");
