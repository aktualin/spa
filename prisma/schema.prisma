// KAMA Spa (kamaspa.id) — schema diturunkan dari Lampiran I kontrak 01/PKS/XI/KAMA/2026.
// Bagian B = struktur halaman publik, Bagian D = 14 modul admin yang harus bisa dikelola tanpa koding.
// Harga disimpan sebagai Int rupiah penuh (tanpa desimal) sesuai DoD modul Harga.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
  EDITOR
}

enum PublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

/* ---------- Modul 14: Pengguna Admin ---------- */

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)

  // Lampiran I poin 8: pembatasan percobaan login admin.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  // Disalin ke JWT; dinaikkan saat password/role/status berubah sehingga
  // semua sesi lama otomatis tidak berlaku.
  sessionVersion     Int       @default(0)
  // Diset saat akun dibuat/di-reset oleh ADMIN: user wajib mengganti sendiri.
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* ---------- Modul 1 & 2: Treatments, Packages, Harga ---------- */

model TreatmentCategory {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  sortOrder   Int     @default(0)

  seoTitle       String?
  seoDescription String?

  treatments Treatment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Treatment {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  imageUrl    String?

  isNew        Boolean @default(false)
  isBestSeller Boolean @default(false)
  isPublished  Boolean @default(true)
  sortOrder    Int     @default(0)

  seoTitle       String?
  seoDescription String?

  // Pesan WhatsApp khusus treatment ini; kosong = pakai template default.
  whatsappMessage String?

  categoryId String
  category   TreatmentCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  options      TreatmentOption[]
  packageItems PackageItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, sortOrder])
}

// Varian durasi + harga untuk satu treatment (mis. 60 min / 90 min).
model TreatmentOption {
  id          String @id @default(cuid())
  label       String
  durationMin Int
  priceIdr    Int
  sortOrder   Int    @default(0)

  treatmentId String
  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([treatmentId, sortOrder])
}

model Package {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  imageUrl    String?
  durationMin Int?
  priceIdr    Int
  isPublished Boolean @default(true)
  sortOrder   Int     @default(0)

  seoTitle        String?
  seoDescription  String?
  whatsappMessage String?

  items PackageItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PackageItem {
  id        String @id @default(cuid())
  sortOrder Int    @default(0)

  // Item bisa merujuk treatment yang ada, atau sekadar teks bebas.
  label String?

  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  treatmentId String?
  treatment   Treatment? @relation(fields: [treatmentId], references: [id], onDelete: SetNull)

  @@index([packageId, sortOrder])
}

/* ---------- Modul 3: Foto & Gallery ---------- */

model GalleryAlbum {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  coverUrl    String?
  isPublished Boolean @default(true)
  sortOrder   Int     @default(0)

  photos GalleryPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryPhoto {
  id        String  @id @default(cuid())
  imageUrl  String
  caption   String?
  altText   String?
  sortOrder Int     @default(0)

  albumId String
  album   GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([albumId, sortOrder])
}

/* ---------- Modul 4: Promos & Gift Card ---------- */

model Promo {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String?
  bannerUrl   String?
  terms       String?

  // Promo otomatis hilang dari publik setelah endDate lewat (DoD modul Promos).
  startDate DateTime?
  endDate   DateTime?

  isPublished Boolean @default(true)
  sortOrder   Int     @default(0)

  seoTitle        String?
  seoDescription  String?
  whatsappMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([endDate])
}

// Singleton: konten halaman Gift Card.
model GiftCardInfo {
  id        String   @id @default("singleton")
  title     String
  bodyHtml  String
  imageUrl  String?
  updatedAt DateTime @updatedAt
}

/* ---------- Modul 5: Membership ---------- */

model MembershipTier {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  priceLabel  String
  billingNote String?
  summary     String?

  // Daftar benefit sebagai list teks yang bisa diedit admin.
  benefits String[]
  terms    String?

  isPublished Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* ---------- Modul 6: Journal ---------- */

model JournalPost {
  id       String  @id @default(cuid())
  slug     String  @unique
  title    String
  excerpt  String?
  bodyHtml String
  coverUrl String?
  category String?
  tags     String[]

  status PublishStatus @default(DRAFT)
  // Dipakai untuk penjadwalan publikasi: tampil publik bila <= now().
  publishedAt DateTime?

  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
}

/* ---------- Modul 7: Events ---------- */

model EventItem {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String?
  coverUrl    String?
  location    String?

  startDate DateTime?
  endDate   DateTime?

  // Memisahkan "upcoming events" dari "past collaborations" (Lampiran I Bagian B).
  isCollaboration Boolean @default(false)
  isPublished     Boolean @default(true)
  sortOrder       Int     @default(0)

  seoTitle       String?
  seoDescription String?

  photos EventPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate])
}

model EventPhoto {
  id        String  @id @default(cuid())
  imageUrl  String
  caption   String?
  sortOrder Int     @default(0)

  eventId String
  event   EventItem @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, sortOrder])
}

/* ---------- Modul 8: KAMA Retail ---------- */

model RetailProduct {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  imageUrl    String?
  priceIdr    Int?

  isHighlight Boolean @default(false)
  isPublished Boolean @default(true)
  sortOrder   Int     @default(0)

  // Tanpa keranjang/pembayaran online — pemesanan lewat WhatsApp (Lampiran I).
  whatsappMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* ---------- Modul 9: Corporate Wellness ---------- */

// Singleton: konten program + PIC halaman Corporate Wellness.
model CorporateContent {
  id             String   @id @default("singleton")
  heroTitle      String
  intro          String?
  inOfficeHtml   String?
  inSpaHtml      String?
  stepsHtml      String?
  picName        String?
  picEmail       String?
  picPhone       String?
  updatedAt      DateTime @updatedAt
}

// Data pribadi (UU PDP, Pasal 11 ayat 7) — hanya dibaca lewat admin action ber-role.
model CorporateInquiry {
  id        String        @id @default(cuid())
  name      String
  company   String?
  email     String
  phone     String?
  message   String
  status    InquiryStatus @default(NEW)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

/* ---------- Modul 10: Homepage & Our Story ---------- */

// Tiap section homepage bisa di-toggle & diurutkan dari dashboard.
model HomepageSection {
  id        String  @id @default(cuid())
  key       String  @unique
  title     String
  subtitle  String?
  bodyHtml  String?
  imageUrl  String?
  isEnabled Boolean @default(true)
  sortOrder Int     @default(0)

  updatedAt DateTime @updatedAt
}

// Singleton: halaman Our Story.
model OurStoryContent {
  id             String   @id @default("singleton")
  heroTitle      String
  heroImageUrl   String?
  philosophyHtml String?
  valuesHtml     String?
  seoTitle       String?
  seoDescription String?
  updatedAt      DateTime @updatedAt
}

/* ---------- Modul 11: Menu Navigasi ---------- */

model MenuItem {
  id        String  @id @default(cuid())
  label     String
  url       String
  sortOrder Int     @default(0)
  isVisible Boolean @default(true)
  openInNew Boolean @default(false)

  parentId String?
  parent   MenuItem?  @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuTree")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, sortOrder])
}

/* ---------- Modul 12: Informasi Kontak & Umum ---------- */

// Singleton: dipakai footer, halaman kontak, dan embed maps.
model SiteSettings {
  id      String @id @default("singleton")
  address String?
  mapsEmbedUrl String?

  // Jam operasional disimpan sebagai teks per baris agar admin bebas mengaturnya.
  openingHours String[]

  whatsappNumber String?
  email          String?
  phone          String?

  instagramUrl String?
  tiktokUrl    String?
  facebookUrl  String?
  freshaUrl    String?

  updatedAt DateTime @updatedAt
}

// Template pesan WhatsApp per konteks (default, treatment, promo, retail, dll).
model WhatsAppTemplate {
  id        String @id @default(cuid())
  key       String @unique
  label     String
  // Boleh memuat placeholder, mis. {{name}}.
  message   String

  updatedAt DateTime @updatedAt
}

/* ---------- Modul 13: SEO ---------- */

model PageSeo {
  id          String  @id @default(cuid())
  path        String  @unique
  title       String?
  description String?
  ogImageUrl  String?

  updatedAt DateTime @updatedAt
}

/* ---------- Modul 14: Halaman & URL ---------- */

enum PageStatus {
  DRAFT
  PUBLISHED
}

// Tata letak halaman publik; menentukan komponen render di src/app/[slug].
enum PageTemplate {
  STANDARD // judul + isi teks berformat
  LEGAL    // tata letak dokumen panjang seperti Kebijakan Privasi
}

// Halaman bebas yang dibuat admin, tampil di /<slug>.
model StaticPage {
  id       String       @id @default(cuid())
  slug     String       @unique
  title    String
  template PageTemplate @default(STANDARD)
  bodyHtml String       @default("")

  seoTitle       String?
  seoDescription String?

  status      PageStatus @default(DRAFT)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Pengalihan URL lama → URL baru, diterapkan di src/proxy.ts. Dibuat otomatis
// saat slug berubah, atau manual dari dashboard. Rantai selalu diratakan
// (A→C, bukan A→B→C) oleh planSlugRedirect di src/lib/domain/page-url.ts.
model Redirect {
  id         String  @id @default(cuid())
  fromPath   String  @unique
  toPath     String
  statusCode Int     @default(301)
  // "auto" = dibuat sistem saat slug berubah; "manual" = diisi admin.
  source     String  @default("manual")
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
