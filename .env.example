# ---------------------------------------------------------------------------
# KAMA Spa (kamaspa.id) — contoh konfigurasi environment
#
# Salin file ini menjadi `.env.local`, lalu isi nilainya. `.env.local` TIDAK
# boleh di-commit — file ini yang masuk ke repo, tanpa satu pun nilai asli.
#
# Di Vercel, isi variabel yang sama lewat Project Settings → Environment
# Variables (Production + Preview).
# ---------------------------------------------------------------------------

# --- Alamat situs -----------------------------------------------------------
# Dipakai sitemap.xml, robots.txt, dan URL Open Graph. Boleh dikosongkan:
# produksi otomatis memakai https://kamaspa.id, preview Vercel memakai
# host preview-nya sendiri.
NEXT_PUBLIC_SITE_URL=""

# --- Database (Supabase Postgres) ------------------------------------------
# DATABASE_URL  : transaction pooler (port 6543) — dipakai aplikasi saat runtime.
# DIRECT_URL    : koneksi langsung (port 5432) — dipakai `prisma migrate`.
# Keduanya wajib: Prisma 7 memakai driver adapter untuk runtime dan koneksi
# langsung untuk Migrate (lihat `prisma.config.ts`).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Sesi admin -------------------------------------------------------------
# Kunci penandatangan JWT sesi admin (HS256, cookie `kama_admin_session`, 8 jam).
# Buat nilai acak minimal 32 karakter, mis.: openssl rand -base64 48
# Mengganti nilai ini akan memaksa seluruh admin login ulang.
ADMIN_SESSION_SECRET=""

# --- Supabase Storage (S3-compatible) ---------------------------------------
# Dipakai untuk unggah foto treatment, galeri, promo, event, dan retail.
# Access key dibuat di Supabase → Project Settings → Storage → S3 Access Keys.
SUPABASE_S3_ENDPOINT_URL="https://<project-ref>.supabase.co/storage/v1/s3"
SUPABASE_S3_REGION="ap-southeast-1"
# Bucket harus PUBLIC (dashboard → Storage → bucket → Settings) agar URL
# /storage/v1/object/public/… bisa dirender tanpa token.
SUPABASE_S3_BUCKET="vip-book"
SUPABASE_S3_ACCESS_KEY_ID=""
SUPABASE_S3_SECRET_ACCESS_KEY=""
# URL publik bucket — dipakai untuk menyusun alamat gambar yang dirender.
NEXT_PUBLIC_SUPABASE_PUBLIC_URL="https://<project-ref>.supabase.co/storage/v1/object/public"

# --- Captcha form Corporate Wellness (Cloudflare Turnstile) -----------------
# WAJIB di produksi: bila TURNSTILE_SECRET_KEY kosong, form inquiry ditutup
# (fail-closed) dan pengunjung diarahkan ke WhatsApp/email. Di development
# verifikasi dilewati dengan peringatan. Honeypot, waktu isi minimum, dan
# rate limit per IP selalu aktif. Nilai site key dibaca saat build — perubahan
# key perlu redeploy.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Notifikasi e-mail inquiry (Resend) -------------------------------------
# Opsional. Bila kosong, inquiry tetap tersimpan dan terlihat di
# /admin/corporate/inquiries, hanya notifikasi e-mail yang tidak terkirim.
RESEND_API_KEY=""
EMAIL_FROM="KAMA Spa <no-reply@kamaspa.id>"
# Alamat PIC yang menerima notifikasi inquiry corporate.
CORPORATE_INQUIRY_TO=""

# --- Instagram feed homepage (opsional) -------------------------------------
# Bila kosong, section Instagram memakai gambar statis dari repo.
INSTAGRAM_USER_ID=""
INSTAGRAM_ACCESS_TOKEN=""

# --- Backup & Status (/admin/status) ----------------------------------------
# Backup otomatis mingguan berjalan di GitHub Actions (.github/workflows/backup.yml),
# bukan di Vercel. Lihat docs/user-guide/status.md dan docs/TECH_HANDOVER.md.
#
# Secret untuk endpoint POST /api/backup/report yang dipanggil workflow.
# Isi nilai acak ≥ 32 karakter (openssl rand -hex 32) dan simpan nilai yang
# SAMA di GitHub secret BACKUP_REPORT_SECRET. Kosong = laporan ditolak (503).
BACKUP_REPORT_SECRET=""
# Opsional: tombol "Jalankan backup pg_dump sekarang" di dashboard.
# Token = fine-grained PAT GitHub, hanya repo backup, izin "Actions: Read and write".
# Kosong = tombol nonaktif (backup mingguan tetap berjalan).
GITHUB_BACKUP_TOKEN=""
# Format pemilik/nama-repo, mis. kamaspa/kamaspa-web.
GITHUB_BACKUP_REPO=""
# Branch tempat workflow berada (default main).
GITHUB_BACKUP_REF="main"
